# LiveKit Cloud supplies these three values automatically after deployment.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Server-to-server QubeSight endpoint. It is not exposed to the browser.
QUBESIGHT_RUNTIME_URL=https://your-project.supabase.co/functions/v1/voice-agent-runtime

# Must match LIVEKIT_AGENT_NAME in the voice-agent-test-session Edge Function.
LIVEKIT_AGENT_NAME=matilda-realtime-agent

# Initial LiveKit Inference pipeline. Tune only after measuring a real call.
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_LLM_MODEL=google/gemma-4-31b-it
LIVEKIT_TTS_MODEL=cartesia/sonic-3
LIVEKIT_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
