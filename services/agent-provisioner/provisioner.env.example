# Generate independently: openssl rand -hex 32
AGENT_PROVISIONER_HMAC_SECRET=replace-with-at-least-32-random-characters
PROVISIONER_BIND_HOST=127.0.0.1
PROVISIONER_BIND_PORT=8090
AGENTS_ROOT=/var/lib/qubesight-agents
PROVISIONER_REQUESTS_ROOT=/var/lib/qubesight-provisioner/requests
CADDY_AGENT_ROUTES_FILE=/etc/caddy/qubesight-agents.caddy
AGENT_PORT_START=11000
AGENT_PORT_END=12999
AGENT_RUNTIME_UID=10001
AGENT_RUNTIME_GID=10001
